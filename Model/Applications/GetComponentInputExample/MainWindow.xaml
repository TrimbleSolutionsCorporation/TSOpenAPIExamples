<Window x:Class="GetComponentInputExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GetComponentInputExample"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="Get Component Input Example" Height="450" Width="800">
    <Grid>
        <Label Name="ModelNameLabel" Content="Model Name: " HorizontalAlignment="Left" Height="25" Margin="10,11,0,0" VerticalAlignment="Top" Width="744"/>
        <TextBox Name="CompInputBox" IsReadOnly="True" HorizontalAlignment="Center" Height="314" TextWrapping="Wrap" Text="{Binding Text, Mode=OneWay}" VerticalAlignment="Center" Width="780"/>
        <Button Name="ReloadButton" Content="Reload" HorizontalAlignment="Left" Height="28" Margin="10,380,0,0" VerticalAlignment="Top" Width="90" Click="OnClick"/>
    </Grid>
</Window>
